{
  "name": "bem-comps-lib",
  "version": "1.0.0",
  "description": "Промо-сайт библиотеки компонент по BEM-мемтодологии",
  "keywords": [],
  "author": "Alexey Ryabkov <xelaris@ya.com>",
  "license": "ISC",
  "engines": {
    "node": ">=22.0.0 <23.0.0"
  },
  "engine-strict": true,
  "scripts": {
    "start": "npm-run-all build serve",
    "build": "parcel build src/index.pug",
    "dev": "parcel src/index.pug",
    "serve": "http-server dist/",
    "parcel": "parcel",
    "lint": "stylelint 'src/**/*.scss' --fix",
    "format": "prettier \"src/**/*.{scss,pug}\" \"*.md\" --write",
    "clear": "rimraf .parcel-cache dist",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "@parcel/transformer-css": {
    "drafts": {
      "customMedia": true,
      "nesting": false
    }
  },
  "devDependencies": {
    "@parcel/transformer-pug": "2.15.4",
    "@parcel/transformer-sass": "2.15.4",
    "@prettier/plugin-pug": "3.4.0",
    "bem-cn": "3.0.1",
    "classnames": "2.5.1",
    "parcel": "2.15.4",
    "postcss-normalize": "13.0.1",
    "prettier": "3.6.0",
    "stylelint": "16.21.0",
    "stylelint-config-standard-scss": "15.0.1",
    "stylelint-prettier": "5.0.3",
    "stylelint-scss": "6.12.1"
  },
  "dependencies": {
    "hover.css": "2.3.2",
    "http-server": "14.1.1",
    "lenis": "1.3.4",
    "npm-run-all": "4.1.5",
    "rimraf": "6.0.1"
  }
}
