mixin radio({ mix, label }, attrs = {})
  -
    const { b, c } = locals;
    const radio = b('radio');
    const isIconLabel = typeof label === 'object';
  label(class=c(radio.mix(mix && mix.block)))
    input(class=c(radio('input')), type='radio')&attributes(attrs)
    span(class=c(radio('state')))
      span(class=c(radio('control')))
      span(class=c(radio('title')))= label
