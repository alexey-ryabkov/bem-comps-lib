mixin checkbox({ mix, label }, attrs = {})
  -
    const { b, c } = locals;
    const checkbox = b('checkbox');
    const isIconLabel = typeof label === 'object';
  label(class=c(checkbox.mix(mix && mix.block)))
    input(class=c(checkbox('input')), type='checkbox')&attributes(attrs)
    span(class=c(checkbox('state')))
      span(class=c(checkbox('control'), '_noAnimateOnload'))
        svg(
          class=c(checkbox('icon')),
          xmlns='http://www.w3.org/2000/svg',
          fill='currentColor'
        )
          use(href='./assets/icons/sprite.svg#check')
      span(class=c(checkbox('title')))= label
