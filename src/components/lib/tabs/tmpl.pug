include ../button/tmpl
mixin tabs({ mix, name = 'tabs', items = {}, openedNum = 0 } = {})
  -
    const { b, c } = locals;
    const tabs = b('tabs');
    const entries = Object.entries(items);
  div(class=c(tabs.mix(mix && mix.block)))
    each itemEntry, num in entries
      - const [tab] = itemEntry;
      input(
        class=c(tabs('tabControl', { tabNum: num + 1 })),
        type='radio',
        id=tab,
        name=name,
        checked=num === openedNum
      )
    div(class=c(tabs('nav')))
      each itemEntry, num in entries
        - const [tab, { label }] = itemEntry;
        label(class=c(tabs('tab')), for=tab)
          span(class=c(tabs('tabTitle', { tabNum: num + 1 }).mix(mix && mix.title)))= label
    each itemEntry, num in entries
      - const [, { content }] = itemEntry;
      div(class=c(tabs('content', { tabNum: num + 1 }).mix(mix && mix.content)))!= content
