mixin button({ mix, text, variant = 'primary', width, isFullWidth = false, isDisabled = false } = {}, attrs = {})
  -
    const { b, c } = locals;
    const button = b('button');
  button(
    class=c(button({ var: variant, width: width || undefined, fullWidth: !width && isFullWidth }).mix(mix && mix.block)),
    disabled=isDisabled
  )&attributes(attrs)= text || block
