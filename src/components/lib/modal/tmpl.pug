mixin modal({ mix, title = '', isOpened = false, isCompact = false, isClosable = true, hasNoViel = false } = {}, attrs = {})
  -
    const { b, c } = locals;
    const modal = b('modal');
  div(
    class=c(modal({ opened: isOpened, compact: isCompact, noVeil: hasNoViel }).mix(mix && mix.block))
  )&attributes(attrs)
    div(class=c(modal('window')))
      if title.length
        h5(class=c(modal('title')))= title
      div(class=c(modal('content')))
        block
      if isClosable
        button(class=c(modal('closeButton')))
          svg(class=c(modal('closeButtonIcon')), xmlns='http://www.w3.org/2000/svg')
            use(href='./assets/icons/sprite.svg#cross') 
