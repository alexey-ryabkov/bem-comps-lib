mixin toggler({ mix, label = '' } = {}, attrs = {})
  -
    const { b, c } = locals;
    const toggler = b('toggler');
    const isIconLabel = typeof label === 'object';
  label(class=c(toggler.mix(mix && mix.block)))
    input(class=c(toggler('input')), type='checkbox')&attributes(attrs)
    span(class=c(toggler('state')))
      if isIconLabel
        svg(
          class=c(toggler('icon', { contrast: label.off.contrast || false })),
          xmlns='http://www.w3.org/2000/svg',
          fill='currentColor'
        )
          use(
            href=`./assets/icons/sprite.svg#${label.off.icon || 'togglerOff'}`
          )
      span(class=c(toggler('control')))
      if isIconLabel
        svg(
          class=c(toggler('icon', { contrast: label.on.contrast || false })),
          xmlns='http://www.w3.org/2000/svg',
          fill='currentColor'
        )
          use(href=`./assets/icons/sprite.svg#${label.on.icon || 'togglerOn'}`)
      else
        span(class=c(toggler('title')))= label
