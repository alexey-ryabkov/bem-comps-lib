mixin tooltip({ mix, position = 'bottom', isOpened = false, isPrimary = true } = {})
  -
    const { b, c } = locals;
    const tooltip = b('tooltip');
  span(class=c(tooltip({ opened: isOpened }).mix(mix && mix.block)))
    svg(class=c(tooltip('trigger')), xmlns='http://www.w3.org/2000/svg')
      use(href='./assets/icons/sprite.svg#question')
    span(class=c(tooltip('bubble', { pos: position, primary: isPrimary }))) 
      if block
        block
      else
        | &nbsp;
