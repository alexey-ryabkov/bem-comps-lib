include ../components/lib/toggler/tmpl
-
  const header = _b('header');  
  const openMenuPanelBtn = _b('openMenuPanelBtn')
header(class=_c(header.mix(page('header'))))
  div(class=_c(layoutContainer()))
    div(class=_c(header('panel')))
      button#menu-panel-open(
        class=_c(openMenuPanelBtn.mix([page('openMenuPanelBtn'), header('openMenuPanelBtn')]))
      )
        svg(
          class=_c(openMenuPanelBtn('icon')),
          xmlns='http://www.w3.org/2000/svg',
          fill='currentColor'
        )
          use(href='./assets/icons/sprite.svg#burger')
      span(class=_c(header('logo'))) #{ libName }
      nav(class=_c(header('menu')))
        a(class=_c(header('menuItem', { active: true })), href) Компоненты
        a(class=_c(header('menuItem')), href) Документация
        a(class=_c(header('menuItem')), href) Контакты
      +toggler(
        {
          label: { 
            off: { icon: 'sun', contrast: 'onLight' }, 
            on: { icon: 'сrescent', contrast: 'onDark' } 
          },
          mix: { block: header('themeToggler') }
        }, 
        { id: 'theme-changer' }
      )
