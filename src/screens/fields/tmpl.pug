.screen
  .previewCard.tileList__item
    .previewCard__placeholder
      .previewCard__preview.previewCard__preview_scaledForMobile
        form.form(action)
          .form__cols
            .formField.form__feild
              label.checkbox
                input.checkbox__input(type='checkbox')
                span.checkbox__state
                  span.checkbox__control._noAnimateOnload
                    svg.checkbox__icon(xmlns='http://www.w3.org/2000/svg')
                      use(href='./assets/icons/sprite.svg#check')
                  span.checkbox__title Default
              label.checkbox
                input.checkbox__input(type='checkbox', checked)
                span.checkbox__state
                  span.checkbox__control._noAnimateOnload
                    svg.checkbox__icon(xmlns='http://www.w3.org/2000/svg')
                      use(href='./assets/icons/sprite.svg#check')
                  span.checkbox__title Checked
              label.checkbox
                input.checkbox__input(type='checkbox', disabled)
                span.checkbox__state
                  span.checkbox__control._noAnimateOnload
                    svg.checkbox__icon(xmlns='http://www.w3.org/2000/svg')
                      use(href='./assets/icons/sprite.svg#check')
                  span.checkbox__title Disabled
            .formField.form__feild
              label.radio
                input.radio__input(type='radio', name='radio2')
                span.radio__state
                  span.radio__control
                  span.radio__title Default
              label.radio
                input.radio__input(type='radio', name='radio2', checked)
                span.radio__state
                  span.radio__control
                  span.radio__title Selected
              label.radio
                input.radio__input(type='radio', disabled, name='radio2')
                span.radio__state
                  span.radio__control
                  span.radio__title Disabled
    h2.previewCard__title Custom form elements
  .componentDetail
    h1.page__title Custom form elements
    form.componentDetail__component.componentDetail__component_columns.form
      .componentDetail__componentColumn.componentDetail__componentColumn_fullWidth
        .formField.form__field
          label.checkbox
            input.checkbox__input(type='checkbox')
            span.checkbox__state
              span.checkbox__control._noAnimateOnload
                svg.checkbox__icon(xmlns='http://www.w3.org/2000/svg')
                  use(href='./assets/icons/sprite.svg#check')
              span.checkbox__title Default
        .formField.form__field
          label.checkbox
            input.checkbox__input(type='checkbox', checked)
            span.checkbox__state
              span.checkbox__control._noAnimateOnload
                svg.checkbox__icon(xmlns='http://www.w3.org/2000/svg')
                  use(href='./assets/icons/sprite.svg#check')
              span.checkbox__title Checked
        .formField.form__field
          label.checkbox
            input.checkbox__input(type='checkbox', disabled)
            span.checkbox__state
              span.checkbox__control._noAnimateOnload
                svg.checkbox__icon(xmlns='http://www.w3.org/2000/svg')
                  use(href='./assets/icons/sprite.svg#check')
              span.checkbox__title Disabled
      .componentDetail__componentColumn.componentDetail__componentColumn_fullWidth
        .formField.form__field
          label.radio
            input.radio__input(type='radio', name='radio')
            span.radio__state
              span.radio__control
              span.radio__title Default
        .formField.form__field
          label.radio
            input.radio__input(type='radio', name='radio', checked)
            span.radio__state
              span.radio__control
              span.radio__title Selected
        .formField.form__field
          label.radio
            input.radio__input(type='radio', disabled, name='radio')
            span.radio__state
              span.radio__control
              span.radio__title Disabled
      .componentDetail__componentColumn.componentDetail__componentColumn_fullWidth
        .formField.form__field
          label.toggler
            input.toggler__input(type='checkbox')
            span.toggler__state
              span.toggler__control
              span.toggler__title Off
        .formField.form__field
          label.toggler
            input.toggler__input(type='checkbox', checked)
            span.toggler__state
              span.toggler__control
              span.toggler__title On
        .formField.form__field
          label.toggler
            input.toggler__input(type='checkbox', checked, disabled)
            span.toggler__state
              span.toggler__control
              span.toggler__title Disabled
    form.componentDetail__component.componentDetail__component_columns.form
      .componentDetail__componentColumn.componentDetail__componentColumn_fullWidth
        .formField.form__field
          label.formField__title(for='default_input') Label
          .formField__field.formField__field_fullWidth
            input#default_input.textInput.textInput_fullWidth.formField__control.formField__control_type_textInput(
              type='text',
              placeholder='Placeholder'
            )
            svg.formField__icon.formField__icon_error(
              xmlns='http://www.w3.org/2000/svg'
            )
              use(href='./assets/icons/sprite.svg#warning')
            svg.formField__icon.formField__icon_success(
              xmlns='http://www.w3.org/2000/svg'
            )
              use(href='./assets/icons/sprite.svg#warning')
          .formField__status Some status
        .formField.formField_disabled.form__field
          label.formField__title(for='disabled_input') Disabled
          .formField__field.formField__field_fullWidth
            input#disabled_input.textInput.textInput_fullWidth.formField__control.formField__control_type_textInput(
              type='text',
              placeholder='Placeholder',
              disabled,
              value='Value'
            )
            svg.formField__icon.formField__icon_error(
              xmlns='http://www.w3.org/2000/svg'
            )
              use(href='./assets/icons/sprite.svg#warning')
            svg.formField__icon.formField__icon_success(
              xmlns='http://www.w3.org/2000/svg'
            )
              use(href='./assets/icons/sprite.svg#checkInCircle')
          .formField__status Some status
      .componentDetail__componentColumn.componentDetail__componentColumn_fullWidth
        .formField.formField_validity_success.form__field
          label.formField__title(for='success_input') Success
          .formField__field.formField__field_fullWidth
            input#success_input.textInput.textInput_fullWidth.formField__control.formField__control_type_textInput(
              type='text',
              placeholder='Placeholder',
              value='Value'
            )
            svg.formField__icon.formField__icon_error(
              xmlns='http://www.w3.org/2000/svg'
            )
              use(href='./assets/icons/sprite.svg#warning')
            svg.formField__icon.formField__icon_success(
              xmlns='http://www.w3.org/2000/svg'
            )
              use(href='./assets/icons/sprite.svg#checkInCircle')
          .formField__status Some status
        .formField.formField_validity_error.form__field
          label.formField__title(for='error_input') Error
          .formField__field.formField__field_fullWidth
            input#error_input.textInput.textInput_fullWidth.formField__control.formField__control_type_textInput(
              type='text',
              placeholder='Placeholder',
              value='Value'
            )
            svg.formField__icon.formField__icon_error(
              xmlns='http://www.w3.org/2000/svg'
            )
              use(href='./assets/icons/sprite.svg#warning')
            svg.formField__icon.formField__icon_success(
              xmlns='http://www.w3.org/2000/svg'
            )
              use(href='./assets/icons/sprite.svg#checkInCircle')
          .formField__status Some status
    .tabs.componentDetail__tabs
      input#html-tab.tabs__tabControl.tabs__tabControl_tabNum_1(
        type='radio',
        name='tabs',
        checked
      )
      input#css-tab.tabs__tabControl.tabs__tabControl_tabNum_2(
        type='radio',
        name='tabs'
      )
      .tabs__nav
        label.tabs__tab(for='#html-tab')
          span.tabs__tabTitle.tabs__tabTitle_tabNum_1 HTML
        label.tabs__tab(for='#css-tab')
          span.tabs__tabTitle.tabs__tabTitle_tabNum_2 CSS
      .tabs__content.tabs__content_tabNum_1
        .componentDetail__tabContent.
          html

      .tabs__content.tabs__content_tabNum_2
        .componentDetail__tabContent.
          css
